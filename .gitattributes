# Keep shell scripts and Linux launcher assets LF so they run on Linux/CI,
# even when committed from Windows.
*.sh        text eol=lf
AppRun      text eol=lf
*.desktop   text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf

# Binary assets must never be line-ending converted.
*.png       binary
*.ico       binary
*.AppImage  binary
